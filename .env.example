# =====================================================================
# ERP TecnoCel - Variables de Entorno (EJEMPLO)
# Copia este archivo como .env.local y coloca tus credenciales reales.
# =====================================================================

# Cadena de conexión a PostgreSQL (Supabase Session Pooler o PostgreSQL local)
# Ejemplo Supabase Session Pooler:
# DATABASE_URL="postgresql://postgres.tu_proyecto:TU_PASSWORD@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"
DATABASE_URL="postgresql://postgres:password@localhost:5432/postgres"

# Clave secreta para firmar el token JWT de sesión (mínimo 32 caracteres)
SESSION_SECRET="cambia_esta_clave_secreta_por_una_segura_erp_tecnocel_2026"
